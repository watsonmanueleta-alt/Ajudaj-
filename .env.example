# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AjudaJá Platform Configuration
# Default admin bootstrap email (automatically granted admin privileges)
INITIAL_ADMIN_EMAIL="watson.manuel.eta@gmail.com"

# Commission & Currency Defaults for Angola
DEFAULT_COMMISSION_RATE=10
DEFAULT_CURRENCY="Kz"
DEFAULT_COUNTRY="AO"

# PayPay Angola Gateway
# Variáveis de ambiente preparadas (ativar apenas quando houver credenciais oficiais do PayPay)
PAYPAY_ENABLED=false
PAYPAY_API_URL=""
PAYPAY_API_KEY=""
PAYPAY_MERCHANT_ID=""
PAYPAY_WEBHOOK_SECRET=""

# Payment Gateways adicionais (Prontos para credenciais reais contratadas em Angola)
# MULTICAIXA_EXPRESS_API_KEY=""
# MULTICAIXA_EXPRESS_ENTITY_ID=""
# APPYPAY_CLIENT_ID=""
# APPYPAY_CLIENT_SECRET=""

